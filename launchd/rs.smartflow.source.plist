<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>rs.smartflow.source</string>

    <!-- Find new qualified leads (>=30K IG followers) → cockpit "Novi leadovi" -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/johhn/.nvm/versions/node/v25.1.0/bin/node</string>
        <string>/Users/johhn/.gemini/antigravity/playground/photonic-lunar/ai-growth-dashboard/source_leads.mjs</string>
        <string>--yes</string>
        <string>--limit</string>
        <string>15</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/johhn/.gemini/antigravity/playground/photonic-lunar/ai-growth-dashboard</string>

    <!-- Daily at 06:00 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>6</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/smartflow-source.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/smartflow-source.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/johhn/.nvm/versions/node/v25.1.0/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
