        <key>PATH</key>
        <string>/Users/johhn/.nvm/versions/node/v25.1.0/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>OBSIDIAN_VAULT_PATH</key>
        <string>/Users/johhn/Library/Mobile Documents/iCloud~md~obsidian/Documents/Smartflow</string>
    </dict>
</dict>
</plist>
