<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>rs.smartflow.send-approved</string>

    <!-- ⚠ SENDS REAL EMAILS. Sends only leads you approved in the cockpit
         (approved_to_send=true). Leave this job UNLOADED until you want
         approved emails to go out automatically on a schedule. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/johhn/.nvm/versions/node/v25.1.0/bin/node</string>
        <string>/Users/johhn/.gemini/antigravity/playground/photonic-lunar/ai-growth-dashboard/send_outreach.mjs</string>
        <string>--mode</string>
        <string>approved</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/johhn/.gemini/antigravity/playground/photonic-lunar/ai-growth-dashboard</string>

    <!-- Daily at 10:00 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>10</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/smartflow-send-approved.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/smartflow-send-approved.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/johhn/.nvm/versions/node/v25.1.0/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
