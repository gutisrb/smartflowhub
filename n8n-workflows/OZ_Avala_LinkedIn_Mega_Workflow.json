              "name": "X-Api-Key",
              "value": "[YOUR_APOLLO_API_KEY]"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"organization_ids\": [\"{{ $json.organizations[0].id }}\"],\n  \"person_titles\": [\n    \"HR\",\n    \"Recruiting\",\n    \"Sourcing\",\n    \"Talent\",\n    \"Operations\",\n    \"People\",\n    \"Project\",\n    \"Manager\"\n  ],\n  \"page\": 1,\n  \"per_page\": 100,\n  \"contact_email_status\": [\"verified\"]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 520],
      "id": "apollo-people-search-001",
      "name": "👥 Find Decision Makers"
    },
    {
      "parameters": {
        "jsCode": "const people = $json.people || [];\nconst jobLocation = $('Loop Over Jobs').item.json.location || \"\";\n\nconst keywords = ['hr', 'recruiting', 'talent', 'people', 'operations', 'project', 'manager'];\n\nconst scored = people.map(p => {\n  const title = (p.title || \"\").toLowerCase();\n  const city = (p.city || \"\").toLowerCase();\n  const state = (p.state || \"\").toLowerCase();\n  \n  let score = 0;\n  \n  // Title keyword match\n  if (keywords.some(k => title.includes(k))) score += 5;\n  \n  // Location match\n  if (jobLocation.toLowerCase().includes(city) || jobLocation.toLowerCase().includes(state)) score += 3;\n  \n  // Email verified\n  if (p.email) score += 2;\n  \n  return { ...p, score };\n});\n\n// Sort by score and return top 5\nconst topPeople = scored\n  .sort((a, b) => b.score - a.score)\n  .slice(0, 5);\n\nreturn topPeople.map(p => ({ json: p }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 520],
      "id": "filter-decision-makers-001",
      "name": "⭐ Score & Filter Top 5"
