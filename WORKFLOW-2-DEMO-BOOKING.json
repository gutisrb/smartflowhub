{
  "name": "AI Agency - Workflow 2: Demo Booking (Part 2)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-part2",
        "options": {}
      },
      "id": "webhook-part2",
      "name": "Webhook - Part 2 Form",
      "position": [
        240,
        300
      ],
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "webhookId": "GENERATE_NEW_WEBHOOK_ID"
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "agency_leads",
        "filters": {
          "conditions": [
            {
              "keyName": "email",
              "condition": "eq",
              "keyValue": "={{ $json.email }}"
            }
          ]
        },
        "returnAll": false,
        "limit": 1
      },
      "id": "supabase-find-lead",
      "name": "Supabase - Find Lead",
      "position": [
        460,
        300
      ],
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "credentials": {
        "supabaseApi": {
          "id": "x9GAXz1Nv6O8J4Vh",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Merge webhook data with existing lead data\nconst webhookData = $input.first().json;\nconst leadData = $('Supabase - Find Lead').first().json;\n\nreturn {\n  // Keep existing data\n  ...leadData,\n  \n  // Add Part 2 data from webhook\n  demo_preference: webhookData.demo_preference,\n  demo_time: webhookData.demo_time || null,\n  meeting_address: webhookData.meeting_address || null,\n  form_stage: 'part2_completed',\n  status: 'Demo Scheduled'\n};"
      },
      "id": "merge-data",
      "name": "Merge Form Data",
      "position": [
        680,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 3
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.demo_preference }}",
                    "operator": {
                      "operation": "eq"
                    },
                    "rightValue": "Video snimak",
                    "id": "video-recording"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 3
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.demo_preference }}",
                    "operator": {
                      "operation": "eq"
                    },
                    "rightValue": "Video poziv",
                    "id": "video-call"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 3
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.demo_preference }}",
                    "operator": {
                      "operation": "eq"
                    },
                    "rightValue": "Uživo u Beogradu",
                    "id": "in-person"
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "switch-demo-type",
      "name": "Switch - Demo Type",
      "position": [
        900,
        300
      ],
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4
    },
    {
      "parameters": {
        "jsCode": "// For video recording - set email to send in 30 minutes\nconst now = new Date();\nconst sendAt = new Date(now.getTime() + 30 * 60000); // 30 min from now\n\nreturn {\n  ...input.all()[0].json,\n  email_type: 'video_demo',\n  next_email_at: sendAt.toISOString()\n};"
      },
      "id": "set-video-demo-email",
      "name": "Set Video Demo Email",
      "position": [
        1140,
        140
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.cal.com/v1/bookings",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "calApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $credentials.apiKey }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "eventTypeId",
              "value": "YOUR_CAL_COM_VIDEO_CALL_EVENT_ID"
            },
            {
              "name": "start",
              "value": "={{ $json.demo_time }}"
            },
            {
              "name": "responses",
              "value": "={{ { \"name\": $json.ime, \"email\": $json.email, \"notes\": \"Prepreka: \" + $json.prepreka + \" | Nedeljni leadovi: \" + $json.nedeljni_leadovi } }}"
            },
            {
              "name": "metadata",
              "value": "={{ { \"kompanija\": $json.kompanija } }}"
            }
          ]
        },
        "options": {}
      },
      "id": "calcom-video-call",
      "name": "Cal.com - Video Call",
      "position": [
        1140,
        300
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.cal.com/v1/bookings",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "calApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $credentials.apiKey }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "eventTypeId",
              "value": "YOUR_CAL_COM_IN_PERSON_EVENT_ID"
            },
            {
              "name": "start",
              "value": "={{ $json.demo_time }}"
            },
            {
              "name": "responses",
              "value": "={{ { \"name\": $json.ime, \"email\": $json.email, \"location\": $json.meeting_address, \"notes\": \"Prepreka: \" + $json.prepreka + \" | Nedeljni leadovi: \" + $json.nedeljni_leadovi } }}"
            },
            {
              "name": "metadata",
              "value": "={{ { \"kompanija\": $json.kompanija, \"address\": $json.meeting_address } }}"
            }
          ]
        },
        "options": {}
      },
      "id": "calcom-in-person",
      "name": "Cal.com - In-Person",
      "position": [
        1140,
        460
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
      "parameters": {
        "jsCode": "// Extract meeting link from Cal.com response and set email sequence\nconst calcomResponse = input.all()[0].json;\nconst leadData = $('Merge Form Data').first().json;\n\n// Calculate when to send confirmation email (2 minutes from now)\nconst now = new Date();\nconst sendAt = new Date(now.getTime() + 2 * 60000);\n\nreturn {\n  ...leadData,\n  meeting_link: calcomResponse.booking?.url || calcomResponse.url || 'MANUAL_LINK_NEEDED',\n  cal_booking_id: calcomResponse.booking?.id || calcomResponse.id,\n  email_type: 'email_2',\n  next_email_at: sendAt.toISOString()\n};"
      },
      "id": "set-meeting-email",
      "name": "Set Meeting Confirmation Email",
      "position": [
        1360,
        380
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "agency_leads",
        "filters": {
          "conditions": [
            {
              "keyName": "email",
              "keyValue": "={{ $json.email }}"
            }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "demo_preference",
              "fieldValue": "={{ $json.demo_preference }}"
            },
            {
              "fieldId": "demo_time",
              "fieldValue": "={{ $json.demo_time }}"
            },
            {
              "fieldId": "meeting_address",
              "fieldValue": "={{ $json.meeting_address }}"
            },
            {
              "fieldId": "meeting_link",
              "fieldValue": "={{ $json.meeting_link }}"
            },
            {
              "fieldId": "email_type",
              "fieldValue": "={{ $json.email_type }}"
            },
            {
              "fieldId": "next_email_at",
              "fieldValue": "={{ $json.next_email_at }}"
            },
            {
              "fieldId": "form_stage",
              "fieldValue": "part2_completed"
            },
            {
              "fieldId": "status",
              "fieldValue": "Demo Scheduled"
            }
          ]
        }
      },
      "id": "supabase-update-lead",
      "name": "Supabase - Update Lead",
      "position": [
        1580,
        300
      ],
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "credentials": {
        "supabaseApi": {
          "id": "x9GAXz1Nv6O8J4Vh",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "allIncomingItems",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "responseBody": "={ \"success\": true, \"message\": \"Demo zakazan! Očekujte email potvrdu uskoro.\", \"demo_type\": \"{{ $json.demo_preference }}\" }"
        }
      },
      "id": "webhook-response",
      "name": "Webhook Response",
      "position": [
        1800,
        300
      ],
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1
    }
  ],
